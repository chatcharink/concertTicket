<div class="fixed w-full grid grid-cols-3 gap-4 z-5 pt-1 pb-1 top-0 bg-red-50/75" id="nav-top-menu-bar">

    <div class="content-center ms-5" style="width: 100px;">
        <% if session["current_user"].blank? %>
            <%= image_tag("#{APP_CONFIG[:application_path]}/pictures/Logo_SW.png", class: "w-full me-2", alt: "logo") %>
        <% else %>
            <%= link_to root_path(), id: "nav-logo" do %>
                <%= image_tag("#{APP_CONFIG[:application_path]}/pictures/Logo_SW.png", class: "w-full me-2", alt: "logo") %>
            <% end %>
        <% end %>
    </div>
    <div class="justify-self-center content-center">
        <% if session["current_user"]["selected_event"].present? %>
            <%= link_to report_path(), class: "font-athiti font-medium text-sm text-red-900 bg-transparent hover:text-white hover:bg-red-900 px-1 sm:px-5 py-2.5 rounded-lg items-center" do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 inline" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <polyline points="4 16 8 12 13 17 20 10" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                    <circle cx="4" cy="16" r="1" /><circle cx="8" cy="12" r="1" /><circle cx="13" cy="17" r="1" /><circle cx="20" cy="10" r="1" />
                </svg> <span class="hidden lg:inline">Report</span>
            <% end %>

            <%= link_to qr_path(), class: "font-athiti font-medium text-sm text-red-900 bg-transparent hover:text-white hover:bg-red-900 px-1 sm:px-5 py-2.5 rounded-lg items-center" do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 inline" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M2 2h6v6H2V2zm2 2v2h2V4H4zM2 10h6v6H2v-6zm2 2v2h2v-2H4zM2 18h6v4H2v-4zm2 2v0h2v0H4zM10 2h6v6h-6V2zm2 2v2h2V4h-2zM10 10h2v2h-2v-2zm4 0h2v2h-2v-2zm-4 4h2v2h-2v-2zm4 4h2v2h-2v-2zm4-8h4v4h-4v-4zm0 6h2v2h-2v-2zm2 2h2v2h-2v-2zm-2 2h2v2h-2v-2z"/>
                </svg> <span class="hidden lg:inline">QR Code</span>
            <% end %>

            <%= link_to scan_qr_path(), class: "font-athiti font-medium text-sm text-red-900 bg-transparent hover:text-white hover:bg-red-900 px-1 sm:px-5 py-2.5 rounded-lg items-center" do %>
                <svg class="w-6 h-6 inline" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                    <path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="M5 12h14"/>
                    <path stroke="currentColor" stroke-linecap="round" d="M6 9.5h12m-12-2h12m-12-2h12m-12 13h12m-12-2h12m-12-2h12"/>
                </svg> <span class="hidden lg:inline">Scan QR</span>
            <% end %>
        <% end %>
    </div>
    <div class="justify-self-end me-2 sm:me-10 items-center">

        <div class="relative inline-block text-left rounded-full">
            <button id="dropdownDefaultLanguage" data-dropdown-toggle="dropdownLangauge" class="bg-transparent text-red-900 hover:bg-red-900 hover:text-white focus:outline-none cursor-pointer font-athiti font-medium rounded-lg text-sm px-3 sm:px-5 py-2.5 text-center inline-flex items-center" type="button">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 hidden sm:inline" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10" />
                    <path d="M2 12h20M12 2a15.3 15.3 0 0 1 0 20M12 2a15.3 15.3 0 0 0 0 20" />
                </svg> <span class="ms-0 sm:ms-2"><%= params[:locale].upcase %></span>
            </button>
            <div id="dropdownLangauge" class="z-10 hidden bg-white divide-y divide-gray-100 rounded-lg shadow-sm w-44 dark:bg-gray-700">
                <ul class="py-2 text-sm text-gray-700 dark:text-gray-200" aria-labelledby="dropdownDefaultLanguage">
                    <li>
                        <%= button_to "English", url_for(locale: "en"), method: "get", class: "block px-4 py-2 hover:bg-red-900 hover:text-white cursor-pointer w-full text-left" %>
                        
                    </li>
                    <li>
                        <%= button_to "Thai", url_for(locale: "th"), method: "get", class: "block px-4 py-2 hover:bg-red-900 hover:text-white cursor-pointer w-full text-left" %>
                    </li>
                </ul>
            </div>
        </div>

        <div class="relative inline-block text-left">
            <% unless session["current_user"].blank? %>
                <button id="dropdownAvatarNameButton" data-dropdown-toggle="dropdownAvatarName" data-dropdown-placement="left-end" class="flex items-center text-sm font-medium text-gray-900 hover:text-red-900 rounded-full px-2 sm:px-5 py-2.5 md:me-0 cursor-pointer" type="button">
                    <span class="sr-only">Open user menu</span>
                    <%= image_tag("#{APP_CONFIG[:application_path]}/pictures/no_image.jpg", class: "w-6 h-6 me-2 rounded-full", alt: "user photo") %>
                    <svg class="w-2.5 h-2.5 text-red-900" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 10 6">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 4 4 4-4"/>
                    </svg>
                </button>

                <!-- Dropdown menu -->
                <div id="dropdownAvatarName" class="z-10 hidden bg-white divide-y divide-gray-100 rounded-lg shadow-sm w-44 dark:bg-gray-700 dark:divide-gray-600">
                    <div class="px-4 py-3 text-sm text-gray-900 dark:text-white">
                        <div class="font-medium "><%= session["current_user"]["firstname"] %> <%= session["current_user"]["lastname"][0..2] %></div>
                        <div class="truncate"><%= session["current_user"]["email"] %></div>
                    </div>

                    <ul class="py-2 text-sm text-gray-700 dark:text-gray-200" aria-labelledby="dropdownInformdropdownAvatarNameButtonationButton">
                        <li>
                            <%= button_to "Change event", root_path(), method: :get, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-red-700 hover:text-white dark:hover:bg-gray-600 dark:text-gray-200 dark:hover:text-white text-left cursor-pointer w-full" %>
                        </li>
                        <li>
                            <%= button_to "User", user_path(), method: :get, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-red-700 hover:text-white dark:hover:bg-gray-600 dark:text-gray-200 dark:hover:text-white text-left cursor-pointer w-full" %>
                        </li>
                    </ul>
                    <div class="py-2">
                        <%= button_to "Log out", logout_path(), method: :get, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-red-700 hover:text-white dark:hover:bg-gray-600 dark:text-gray-200 dark:hover:text-white text-left cursor-pointer w-full" %>
                    </div>
                </div>
            <% end %>

        </div>
    </div>

</div>
