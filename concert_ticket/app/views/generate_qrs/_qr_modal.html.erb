<!-- Modal toggle -->
<button data-modal-target="qr-static-modal" data-modal-toggle="qr-static-modal" class="hidden text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800" type="button" id="btn-modal-qr">
    Show QR
</button>

<!-- Main modal -->
<div id="qr-static-modal" data-modal-backdrop="static" tabindex="-1" aria-hidden="true" class="hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 justify-center items-center w-full md:inset-0 h-[calc(100%-1rem)] max-h-full z-60 rounded-lg">
    <div class="relative p-4 w-full max-w-2xl max-h-full">
        <!-- Modal content -->
        <div class="relative bg-white rounded-lg shadow-sm dark:bg-gray-700">
            <!-- Modal header -->
            <div class="flex items-center justify-between p-4 md:p-5 border-b rounded-t dark:border-gray-600 border-gray-200 bg-red-900">
                <h3 class="text-xl font-athiti font-semibold text-white">
                    <%= t("qr_modal.title") %>
                </h3>
                <%# <button type="button" class="text-white bg-transparent hover:bg-gray-200 hover:text-gray-900 cursor-pointer rounded-lg text-sm w-8 h-8 ms-auto inline-flex justify-center items-center dark:hover:bg-gray-600 dark:hover:text-white" data-modal-hide="qr-static-modal">
                    <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
                    </svg>
                    <span class="sr-only">Close modal</span>
                </button> %>
            </div>
            <!-- Modal body -->
            <div class="p-4 md:p-5 space-y-4">
                <% if @qr_code.present? %>
                    <div>
                        <span class="font-athiti font-medium text-lg"><%= t("qr_modal.location_name") %>: <%= @qr_code.location %></span>
                    </div>
                    <div>
                        <span class="font-athiti font-medium text-lg"><%= t("qr_modal.remain_quota") %>: <%= @qr_code.numbers - @qr_code.ticket_used %></span>
                    </div>
                    <div class="m-auto my-10 rounded-md bg-white size-50 md:size-90">
                        <% if @qr_code.qr_code.attached? %>
                            <%= image_tag(url_for(@qr_code.qr_code), class: "w-full h-full rounded-md") %>
                        <% end %>
                    </div>
                <% end %>
            </div>
            <!-- Modal footer -->
            <div class="grid grid-cols-3">
                <% if @qr_code.present? %>
                    <div class="col-span-2 inline-flex border-t border-gray-200 p-4 md:p-5">
                        <%= button_to '<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 me-3 text-white dark:text-white" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M2 4h20a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm0 2v.01L12 13 22 6.01V6H2zm0 2.236V18h20V8.236L12 15 2 8.236z"/>
                            </svg><span class="font-athiti font-semibold text-white">Send mail</span>'.html_safe,  send_mail_path(qr_id: @qr_code.id), type: "button", method: "post", class: "font-athiti font-semibold text-white bg-red-400 inline-flex cursor-pointer hover:bg-red-700 focus:ring-4 focus:outline-none font-medium rounded-lg text-sm px-5 py-2.5 text-center mx-2" %>
                    </div>
                <% end %>
                <div class="col-span-1 relative items-center p-4 md:p-5 border-t border-gray-200 rounded-b text-right w-full">
                    <button data-modal-hide="qr-static-modal" type="button" class="font-athiti font-semibold text-white bg-red-900 cursor-pointer hover:bg-red-700 focus:ring-4 focus:outline-none font-medium rounded-lg text-sm px-5 py-2.5 text-center mx-2" id="close-qr-modal"><%= t("qr_modal.btn_close_modal") %></button>
                </div>
            </div>
        </div>
    </div>
</div>
