<div id="new-event-modal" tabindex="-1" aria-hidden="true" class="hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 justify-center items-center w-full md:inset-0 h-[calc(100%-1rem)] max-h-full">
    <div class="relative p-4 w-full max-w-md max-h-full">
        <!-- Modal content -->
        <div class="relative bg-white rounded-lg shadow-sm dark:bg-gray-700">
            <!-- Modal header -->
            <div class="flex items-center justify-between p-4 md:p-5 border-b rounded-t dark:border-gray-600 border-gray-200">
                <h3 class="font-athiti text-lg font-semibold text-gray-900 dark:text-white" id="title-action-event" data-default="<%= t("add_event.title") %>">
                    <%= title %>
                </h3>
                <button type="button" id="close-event-action-modal" class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 ms-auto inline-flex justify-center items-center dark:hover:bg-gray-600 dark:hover:text-white cursor-pointer" data-modal-toggle="new-event-modal">
                    <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
                    </svg>
                    <span class="sr-only">Close modal</span>
                </button>
            </div>
            <!-- Modal body -->
            <%= form_for "form_concert", url: create_event_path(format: :json), html: {class: "p-4 md:p-5"}, method: :POST do |f| %>
                <div class="grid gap-4 mb-4 grid-cols-2">
                    <div class="col-span-2">
                        <label for="event-name" class="font-athiti block mb-2 text-sm font-medium text-gray-900 dark:text-white"><%= t("add_event.event_name") %></label>
                        <%= f.text_field :event_name, value: name, id: "event-name", class: "block w-full font-athiti rounded-md bg-white px-3 py-1.5 text-base text-gray-900 border-gray-400 -outline-offset-1 outline-gray-200 focus:border-gray-200 focus:border-gray-200 placeholder:text-gray-400 sm:text-sm/6", required: true %>
                    </div>
                    <div class="col-span-2">
                        <label for="event-date" class="font-athiti block mb-2 text-sm font-medium text-gray-900 dark:text-white"><%= t("add_event.date") %></label>
                        <%= f.date_field :event_date, as: :date, value: date, class: "block w-full font-athiti rounded-md bg-white px-3 py-1.5 text-base text-gray-900 border-gray-400 -outline-offset-1 outline-gray-200 focus:border-gray-200 focus:border-gray-200 placeholder:text-gray-400 sm:text-sm/6" , id: "event-date", required: true %>
                    </div>
                    <div class="col-span-2">
                        <div class="flex gap-3">
                            <div class="flex h-6 shrink-0 items-center">
                                <div class="group grid size-4 grid-cols-1">
                                    <%= f.check_box :is_default, {id: "set_default", class: "col-start-1 row-start-1 appearance-none rounded-sm border border-gray-300 bg-white checked:border-red-600 checked:bg-red-900 checked:text-red-900 indeterminate:border-red-600 indeterminate:bg-red-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600 disabled:border-gray-300 disabled:bg-gray-100 disabled:checked:bg-gray-100 forced-colors:appearance-auto", checked: is_check}, 1 %>
                                </div>
                            </div>
                            <div class="text-sm/6">
                                <label for="set_default" class="font-athiti font-medium text-gray-900"><%= t("add_event.check_default") %></label>
                            </div>
                        </div>                
                    </div>
                    <%= f.hidden_field :update_id, value: id, id: "update-event-id" %>
                </div>

                <div class="text-right">
                    <%= f.submit button, class: "rounded-md bg-red-900 px-3 py-2 text-sm font-athiti font-semibold text-white shadow-xs hover:bg-red-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-900 cursor-pointer", id: "btn-submit-action-event", "data-default": "#{t("add_event.btn_create_event")}" %>
                </div>
            <% end %>
        </div>
    </div>
</div> 