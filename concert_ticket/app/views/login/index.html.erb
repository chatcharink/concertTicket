<div class="justify-content-center items-center min-h-screen content-center">
    <div class="grid grid-cols-1 gap-x-6 gap-y-30 md:gap-y-5 justify-content-center items-center h-fit w-2xl m-auto bg-white rounded-lg p-10">
        <%= form_for "form_login", url: login_authenication_path(format: :json), method: :POST do |f| %>
        
        <div class="sm:col-span-full m-auto">
            <%= image_tag("#{APP_CONFIG[:application_path]}/pictures/Logo_SW.png", class: "me-2 mb-2 justify-self-center", style: "width: 200px", alt: "logo") %>
        </div>

        <div class="sm:col-span-full">
            <label for="username" class="font-athiti block text-sm/6 font-semibold text-gray-900">Username/Email</label>
            <div class="mt-2">
                <%= f.text_field :username, value: "", id: "username", class: "font-athiti font-medium bg-white border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500  block w-full p-2.5" %>
            </div>
        </div>

        <div class="sm:col-span-full mt-10">
            <label for="password" class="font-athiti block text-sm/6 font-semibold text-gray-900">Password</label>
            <div class="mt-2">
                <%= f.password_field :password, value: "", id: "password", class: "font-athiti font-medium bg-white border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500  block w-full p-2.5" %>
            </div>
        </div>

        <div class="sm:col-span-full mt-10 justify-self-center">
            <%= f.submit "Login", class: "rounded-md bg-red-900 px-3 py-2 text-sm font-athiti font-semibold text-white shadow-xs hover:bg-red-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-900" %>
        </div>

        <% end %>
    </div>
</div>
