<!DOCTYPE html>
<html>
    <head>
        <meta name="viewport" content="width=device-width,initial-scale=1">
        <style>
            .div-box{
                margin: auto;
                width: 50%;
                border: 1px solid #d7d7d7;
                border-radius: 20px;
                font-family: "Athiti", sans-serif !important;
                font-weight: 500;
                font-style: normal;
                color: #3b3c66;
            }

            @media only screen and (max-width: 1024px) {
                .div-box{
                    width: 90% !important;
                }
            }

            .head-email{
                background-image: linear-gradient(90deg, #0080ff, #eff7f9);;
                background-attachment: fixed;
                background-repeat: no-repeat;
                background-size: cover;
                color: #fff;
                font-weight: 500;
                padding: 15px;
            }

            .head-email{
                border-top-left-radius: 20px;
                border-top-right-radius: 20px;
            }

            .foot-email{
                border-top: 1px solid #d7d7d7;
                border-bottom-left-radius: 20px;
                border-bottom-right-radius: 20px;
                padding: 15px;
            }

            .body-email{
                padding: 15px;
            }

            .btn-primary{
                background: #0080ff;
                color: #fff !important;
                border: none !important;
                width: fit-content;
                border-radius: 10px;
                padding: 10px;
                text-decoration: none;
                margin: 20px;
            }

            .btn-primary:hover{
                /* background-position: left bottom; */
            }

            #div-btn-reset{
                text-align: center;
            }
        </style>
    </head>
    <body> 
        <div class="div-box">
            <div class="head-email">
                <h3><b>Hi <%= @receiver.location %></b></h3>
            </div>
            <div class="body-email">
                <p style="margin-bottom: 40px;">Someone registered from your QR, This is your infotmation,</p>
                <p style="margin-bottom: 40px; margin-left: 20px">Company name: <%= @receiver.location %></p>
                <p style="margin-bottom: 40px; margin-left: 20px">Numbers of Quota: <%= @receiver.numbers.to_i - @receiver.ticket_used.to_i %></p>
                
                <div id="div-btn-reset">
                  <img src="cid:qr.jpg" alt="QRcode" />
                </div>
            </div>

            <div class="foot-email">
                <p>Thanks,</p>
                <p>The PD music Team</p>
            </div>
        </div>
    </body>
</html>
