<div class="fixed w-full grid grid-cols-3 gap-4 z-5 pt-1 pb-1 top-0 left-0 bg-red-50/75" id="nav-top-menu-bar">

    <div class="content-center ms-5" style="width: 100px;">
        <%= image_tag("#{APP_CONFIG[:application_path]}/pictures/Logo_SW.png", class: "w-full me-2", alt: "logo") %>
    </div>

    <div></div>

    <div class="justify-self-end me-2 sm:me-10 items-center">

        <div class="relative inline-block text-left rounded-full">
            <button id="dropdownDefaultLanguage" data-dropdown-toggle="dropdownLangauge" class="bg-transparent text-red-900 hover:bg-red-900 hover:text-white focus:outline-none cursor-pointer font-athiti font-medium rounded-lg text-sm px-3 sm:px-5 py-2.5 text-center inline-flex items-center" type="button">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 hidden sm:inline" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10" />
                    <path d="M2 12h20M12 2a15.3 15.3 0 0 1 0 20M12 2a15.3 15.3 0 0 0 0 20" />
                </svg> <span class="ms-0 sm:ms-2"><%= params[:locale].upcase %></span>
            </button>
            <div id="dropdownLangauge" class="z-10 hidden bg-white divide-y divide-gray-100 rounded-lg shadow-sm w-44 dark:bg-gray-700">
                <ul class="py-2 text-sm text-gray-700 dark:text-gray-200" aria-labelledby="dropdownDefaultLanguage">
                    <li>
                        <%= button_to "English", url_for(locale: "en"), method: "get", class: "block px-4 py-2 hover:bg-red-900 hover:text-white cursor-pointer w-full text-left" %>
                        
                    </li>
                    <li>
                        <%= button_to "Thai", url_for(locale: "th"), method: "get", class: "block px-4 py-2 hover:bg-red-900 hover:text-white cursor-pointer w-full text-left" %>
                    </li>
                </ul>
            </div>
        </div>
    </div>
    
</div>

<div class="w-full bg-white rounded-md p-8 max-w-[90%] md:max-w-2xl !mx-5 sm:!mx-auto my-10" id="div-form-register" data-controller="register">
    <%= render partial: "form_register" %>
</div>
