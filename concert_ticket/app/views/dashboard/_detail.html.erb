<script src="https://cdn.jsdelivr.net/npm/simple-datatables@9.0.3"></script>

<div class="relative overflow-x-auto sm:rounded-lg">
    <div class="grid grid-cols-2 mb-5 justify-self-end w-md">
        <div class="self-end">
            <label for="search-detail" class="block mb-2 text-right text-sm font-athiti font-medium text-gray-900 dark:text-white pe-5"><%= t("dashboard.search") %> : </label>
        </div>
        <div>
            <input type="text" id="search-detail" class="font-athiti w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 border-gray-400 -outline-offset-1 outline-gray-200 focus:border-gray-200 focus:border-gray-200 placeholder:text-gray-400 sm:text-sm/6" data-action="keyup->dashboard#search_detail" />
        </div>
    </div>
    <%= content_tag :table, class: "w-full text-sm text-left rtl:text-right text-gray-800 rounded-t-2xl", id: "table-dashboard", width: "100%", data: { url: datatable_path(format: :json) } do %>
        <thead class="text-xs text-white uppercase bg-red-900 dark:bg-gray-700 dark:text-gray-400">
            <tr>
                <th scope="col" rowspan="2" class="font-athiti text-sm px-6 py-3"><%= t("dashboard.table.column1") %></th>
                <th scope="col" rowspan="2" class="font-athiti text-sm text-center px-6 py-3"><%= t("dashboard.table.column2") %></th>
                <th scope="col" rowspan="2" class="font-athiti text-sm text-center px-6 py-3"><%= t("dashboard.table.column3") %></th>
                <th scope="col" rowspan="2" class="font-athiti text-sm px-6 py-3"><%= t("dashboard.table.column4") %></th>
                <th scope="col" rowspan="2" class="font-athiti text-sm px-6 py-3"><%= t("dashboard.table.column5") %></th>
                <th scope="col" rowspan="2" class="font-athiti text-sm px-6 py-3"><%= t("dashboard.table.column6") %></th>
                <th scope="col" colspan="2" class="font-athiti text-center text-sm px-6 py-3" style="border-bottom: 1px solid white !important;"><%= t("dashboard.table.column7") %></th>
                <th scope="col" rowspan="2" class="font-athiti text-sm text-center px-6 py-3"><%= t("dashboard.table.column8") %></th>
            </tr>
            <tr>
                <th scope="col" class="font-athiti text-sm text-center px-6 py-3"><%= t("dashboard.table.subcolumn1") %></th>
                <th scope="col" class="font-athiti text-sm text-center px-6 py-3"><%= t("dashboard.table.subcolumn2") %></th>
            </tr>
        </thead>
        <tbody>
        
        </tbody>
    <% end %>
</div>
