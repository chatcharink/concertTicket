<!-- Modal toggle -->
<button data-modal-target="scan-result-modal" data-modal-toggle="scan-result-modal" class="hidden text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800" type="button">
  Toggle modal
</button>

<!-- Main modal -->
<div id="scan-result-modal" data-modal-backdrop="static" tabindex="-1" aria-hidden="true" class="hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 justify-center items-center w-full md:inset-0 h-[calc(100%-1rem)] max-h-full">
    <div class="relative p-4 w-full max-w-2xl max-h-full">
        <!-- Modal content -->
        <div class="relative bg-white rounded-lg shadow-sm dark:bg-gray-700">
            <!-- Modal header -->
            <div class="flex items-center justify-between p-4 md:p-5 border-b rounded-t dark:border-gray-600 border-gray-200 bg-red-900">
                <h3 class="text-xl font-athiti font-semibold text-white">
                    <%= t("scan_qr.participate_modal.title") %>
                </h3>
            </div>
            <!-- Modal body -->
            <div class="p-4 md:p-5 space-y-4">
                
                <% if @register_user.present? %>
                    <div class="flex justify-center items-center mt-3">
                        <svg class="w-20 h-20 text-green-500 animate-bounce" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.5 11.5 11 14l4-4m6 2a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
                        </svg>
                    </div>
                    <div class="flex justify-center items-center">
                        <p class="font-athiti font-semibold text-xl text-green-500"><%= t("scan_qr.participate_modal.success_message") %></p>
                    </div>
                    <p class="font-athiti text-l"><%= t("scan_qr.participate_modal.fullname") %> : <%= @register_user.firstname %> <%= @register_user.lastname %></p>
                    <p class="font-athiti text-l"><%= t("scan_qr.participate_modal.phone_number") %> : <%= @register_user.phone_number %></p>
                    <p class="font-athiti text-l"><%= t("scan_qr.participate_modal.country_province") %> : <%= @register_user.country %>/<%= @register_user.province %></p>
                    <p class="font-athiti text-l"><%= t("scan_qr.participate_modal.channel_to_know") %> : <%= @register_user.channel_to_know %></p>
                    <p class="font-athiti text-l"><%= t("scan_qr.participate_modal.ticket_from") %> : <%= @register_user.location %></p>
                <% else %>
                    <div class="flex justify-center items-center mt-3">
                        <svg class="w-20 h-20 text-red-500 animate-bounce" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 13V8m0 8h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
                        </svg>
                    </div>
                    <div class="flex justify-center items-center">
                        <p class="font-athiti font-semibold text-xl text-green-500"><%= t("scan_qr.participate_modal.error_message") %></p>
                    </div>
                     <p class="font-athiti text-l"><%= t("scan_qr.participate_modal.error_sub_message") %></p>
                <% end %>
            </div>
            <!-- Modal footer -->
            <div class="flex items-center p-4 md:p-5 border-t border-gray-200 rounded-b dark:border-gray-600">
                <button data-modal-hide="scan-result-modal" id="close-scan-result-modal" type="button" class="text-white bg-red-900 hover:bg-red-600 focus:ring-4 focus:outline-none focus:ring-red-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center cursor-pointer">OK</button>
            </div>
        </div>
    </div>
</div>
